source "https://rubygems.org"

# Pinned for reproducibility. Tested on Ruby 3.3.x.
# IMPORTANT: asciidoctor-pdf < 2.4 is incompatible with Ruby 4.0
# (depends on stdlib gems removed in 4.0).
ruby ">= 3.0", "< 4.0"

gem "asciidoctor",             "~> 2.0"
gem "asciidoctor-pdf",         "~> 2.3"
gem "asciidoctor-epub3",       "~> 2.1"
gem "asciidoctor-diagram",     "~> 2.3"
gem "asciidoctor-mathematical", "~> 0.3"
gem "rouge",                   "~> 4.0"
